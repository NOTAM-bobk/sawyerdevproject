# ---------------------------------------------------------------------------
# Project enquiry email delivery (optional)
#
# The "Start a project" form posts to /api/start. Without these variables the
# route reports that delivery is not configured and the form falls back to a
# pre-filled email, so nothing is ever lost.
#
# Create a Plunk account, add a project, then copy the SECRET key (sk_...) from
# Settings -> API Keys. https://docs.useplunk.com/guides/api-keys
# ---------------------------------------------------------------------------
PLUNK_SECRET_KEY=

# The address that receives enquiries. Must be on a domain verified in Plunk.
CONTACT_TO_EMAIL=hello@sawyerschulz.dev

# The "from" address for those emails. Its domain must be verified in Plunk,
# otherwise their API rejects the send.
CONTACT_FROM_EMAIL=hello@sawyerschulz.dev
