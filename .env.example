# ---------------------------------------------------------------------------
# Project enquiry email delivery (optional)
#
# The "Start a project" form posts to /api/start. Without these variables the
# route reports that delivery is not configured and the form falls back to a
# pre-filled email, so nothing is ever lost.
#
# Create a Plunk account, add a project, then copy the SECRET key (sk_...) from
# Settings -> API Keys. https://docs.useplunk.com/guides/api-keys
# ---------------------------------------------------------------------------
PLUNK_SECRET_KEY=

# The address that receives enquiries. Must be on a domain verified in Plunk.
CONTACT_TO_EMAIL=035665@mtka.org

# The "from" address for those emails. Its domain must be verified in Plunk,
# otherwise their API rejects the send.
CONTACT_FROM_EMAIL=035665@mtka.org

# ---------------------------------------------------------------------------
# Admin panel password (/admin)
#
# One variable. It is the password you type, and it also signs the session
# cookie — changing it signs out every device. Use something long: this is the
# only thing standing in front of the enquiry list.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Client dashboards (/dashboard)
#
# Nothing extra to set: clients sign in with the code they are given when they
# send an enquiry, and that code opens their own dashboard only. The admin
# password above also opens /dashboard as the admin, which is how you get the
# list of every client. Without MONGODB_URI the client side of the dashboard is
# simply switched off and the sign-in page says so.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Enquiry storage (MongoDB Atlas)
#
# Enquiries are saved here as well as emailed, so a mail outage can never lose
# one. Create a free M0 cluster at https://www.mongodb.com/atlas, add a
# database user, allow access from anywhere (0.0.0.0/0) under Network Access,
# then copy the connection string from Connect -> Drivers. Include the database
# name, e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/sawyer
#
# Without this the form still works — it just falls back to email only.
# ---------------------------------------------------------------------------
MONGODB_URI=

# ---------------------------------------------------------------------------
# Canonical site URL (optional)
#
# Used for canonical tags, Open Graph, the sitemap and the JSON-LD. On Vercel
# this is worked out for you from the project's production domain, so leave it
# empty unless you want to force a particular one — then set it to your domain
# including the scheme, e.g. https://yourdomain.com. It is baked in at build
# time, so a change needs a redeploy.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
